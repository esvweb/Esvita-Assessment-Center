# ---- Vapi (voice) ----
# Dashboard > Assistants > API Keys. The public key is safe in the browser.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# Private key: only used server-side (fetching call artifacts / verifying webhooks)
VAPI_PRIVATE_KEY=
# Shared secret you set on the Vapi assistant's server URL; verifies webhook calls
VAPI_WEBHOOK_SECRET=
# LLM that drives the patient during voice calls
VAPI_VOICE_MODEL=gpt-4.1

# ---- OpenAI (chat patient + evaluation report) ----
OPENAI_API_KEY=
# Messaging patient — short turns, so latency matters
OPENAI_CHAT_MODEL=gpt-5.4
# Grader — one long judgement-heavy call per session
OPENAI_REPORT_MODEL=gpt-5.5

# ---- Neon (Postgres) ----
# Neon dashboard > Connection string (pooled). Server-side only.
DATABASE_URL=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Panel access ----
# The admin account lives here, not in the database, so you can sign in while
# the database is still being set up. Everyone else is added from the panel and
# signs in with a one-time code emailed to them.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=
# Signs session cookies. Any long random string; changing it signs everyone out.
AUTH_SECRET=

# ---- Email for login codes (Brevo SMTP) ----
# Leave blank during setup: codes are written to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be a sender address verified on the Brevo account.
MAIL_FROM=
